{
    "name": "quillstack/response",
    "description": "The response object based on PSR-7: HTTP messages, and with the main goal: to be simple and fast.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://quillstack.org/packages/response",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "ext-json": "*",
        "php": "^8.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "quillstack/di": "^0.6",
        "quillstack/header-bag": "^0.7",
        "quillstack/stream": "^0.8",
        "quillstack/validator-interface": "^0.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Response\\": "src/",
            "Quillstack\\Response\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
